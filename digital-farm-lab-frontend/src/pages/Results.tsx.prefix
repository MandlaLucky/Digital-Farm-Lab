import { Button, Icon, Progress } from '../components/ui'
import type { RunRecord } from '../scenarioTypes'

function Trend({ run, pick, color, label, target }: { run: RunRecord; pick: (p: RunRecord['series'][number]) => number; color: string; label: string; target?: number }) {
  const pts = run.series
  const max = Math.max(1, target ?? 0, ...pts.map(pick))
  const w = 320, h = 110
  const x = (i: number) => pts.length === 1 ? w / 2 : (i / (pts.length - 1)) * w
  const y = (v: number) => h - 8 - (v / max) * (h - 20)
  const line = pts.map((p, i) => `${x(i).toFixed(1)},${y(pick(p)).toFixed(1)}`).join(' ')
  return (
    <figure className="trend">
      <figcaption><strong>{label}</strong><span>{target !== undefined ? `target ${target} (dashed) · ` : ''}peak {Math.round(Math.max(...pts.map(pick)))}</span></figcaption>
      <svg viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="none" role="img" aria-label={`${label} over simulation days`}>
        <path d={`M0 ${h * .25}H${w}M0 ${h * .5}H${w}M0 ${h * .75}H${w}`} className="chart-grid-lines" />
        {target !== undefined && <line x1="0" x2={w} y1={y(target)} y2={y(target)} stroke="#e4f1ec" strokeDasharray="4 4" strokeWidth="1" opacity=".6" vectorEffect="non-scaling-stroke" />}
        <polygon points={`0,${h} ${line} ${w},${h}`} fill={color} opacity=".12" />
        <polyline points={line} fill="none" stroke={color} strokeWidth="2" vectorEffect="non-scaling-stroke" />
      </svg>
      <div className="trend-axis"><span>Day {pts[0]?.day}</span><span>Day {pts[pts.length - 1]?.day}</span></div>
    </figure>
  )
}

const stageDefs = [
  { name: 'Seedbed', to: 10, note: 'Seeds need steady moisture and warmth to start.' },
  { name: 'Emergence', to: 28, note: 'Seedlings are fragile; both drought and waterlogging hurt most here.' },
  { name: 'Vegetative', to: 55, note: 'Rapid leaf growth; demand for water and nitrogen peaks.' },
  { name: 'Tasseling', to: 78, note: 'Flowering is the most stress-sensitive stage for yield.' },
  { name: 'Maturity', to: 100, note: 'Grain fills; demand drops and over-watering wastes water.' },
]

function stageRows(run: RunRecord) {
  let prev = 0
  const rows: { name: string; note: string; from: number; to: number; avgMoisture: number; growthGain: number; water: number }[] = []
  let lastGrowth = 0, lastWater = 0
  stageDefs.forEach(def => {
    const pts = run.series.filter(p => { const pr = (p.day / run.duration) * 100; return pr > prev && pr <= def.to })
    if (pts.length) {
      const last = pts[pts.length - 1]
      rows.push({ name: def.name, note: def.note, from: pts[0].day, to: last.day, avgMoisture: Math.round(pts.reduce((a, p) => a + p.moisture, 0) / pts.length), growthGain: last.growth - lastGrowth, water: last.water - lastWater })
      lastGrowth = last.growth; lastWater = last.water
    }
    prev = def.to
  })
  return rows
}

const grade = (n: number) => n >= 85 ? 'Excellent' : n >= 70 ? 'Good' : n >= 55 ? 'Fair' : 'Needs work'

function Explain({ label, value, formula, inputs, meaning, improve }: { label: string; value: number; formula: string; inputs: string; meaning: string; improve: string }) {
  return (
    <div className="explain">
      <div className="explain-head"><strong>{label}</strong><b>{value}/100 · {grade(value)}</b></div>
      <Progress value={value} tone={value >= 70 ? 'green' : value >= 55 ? 'amber' : 'blue'} />
      <dl>
        <dt>How it is calculated</dt><dd><code>{formula}</code></dd>
        <dt>Your numbers</dt><dd>{inputs}</dd>
        <dt>What it means</dt><dd>{meaning}</dd>
        <dt>How to improve it</dt><dd>{improve}</dd>
      </dl>
    </div>
  )
}

export default function Results({ run, history, onSelect, onBrowse, onSimulate }: {
  run: RunRecord | null
  history: RunRecord[]
  onSelect: (run: RunRecord) => void
  onBrowse: () => void
  onSimulate: () => void
}) {
  if (!run) {
    return (
      <div className="page center-page">
        <div className="scenario-empty-card">
          <div><Icon name="chart" size={29} /></div><span>NO RESULTS YET</span><strong>Run a simulation first</strong>
          <p>Results and learning feedback appear here when you finish a simulation run.</p>
          <Button onClick={onSimulate}><Icon name="play" size={15} /> Open simulation workspace</Button>
        </div>
      </div>
    )
  }

  const shareResults = async () => {
    const text = `I scored ${run.scores.overall}/100 on "${run.scenarioName}" in Digital Farm Lab!`
    const url = window.location.href
    try {
      if (navigator.share) {
        await navigator.share({ title: 'Digital Farm Lab', text, url })
      } else if (navigator.clipboard) {
        await navigator.clipboard.writeText(text + ' ' + url)
        alert('Copied to clipboard')
      } else {
        alert(text + ' ' + url)
      }
    } catch { /* user cancelled */ }
  }  const d = run.details
  const sc = run.scores
  const dec = run.decisions
  const stages = stageRows(run)
  const achieved = run.objectives.filter(o => o.achieved).length
  const parts = [['moisture control', sc.moisture], ['water efficiency', sc.water], ['nutrient management', sc.nutrients]] as const
  const best = [...parts].sort((a, b) => b[1] - a[1])[0]
  const worst = [...parts].sort((a, b) => a[1] - b[1])[0]
  const gap = d?.avgMoistureGap
  const kpis = [
    { label: 'OVERALL SCORE', value: sc.overall, unit: '/100', sub: grade(sc.overall) },
    { label: 'SIMULATED YIELD', value: run.metrics.yieldTHa, unit: ' t/ha', sub: 'Base 3.5 + growth × quality' },
    { label: 'WATER USED', value: run.metrics.waterUsed, unit: ' m³', sub: d ? `at ${d.effectiveFlow} L/min effective flow` : 'total irrigation' },
    { label: 'CROP GROWTH', value: run.metrics.growth, unit: '%', sub: run.complete ? 'full season' : `to day ${run.dayReached} of ${run.duration}` },
  ]
  const recs: string[] = []
  if (sc.moisture < 70) recs.push(`Moisture control was your weakest area${gap !== undefined ? `: soil moisture averaged ${gap} points away from your ${dec.targetMoisture}% target` : ''}. Re-run with the flow rate nudged up or down by 3–5 L/min and compare the moisture chart against the dashed target line. Placing soil probes and drip lines also helps.`)
  if (sc.water < 85) recs.push(`Your flow rate of ${dec.flowRate} L/min is ${Math.abs(dec.flowRate - 22)} L/min ${dec.flowRate > 22 ? 'above' : 'below'} the model's most efficient rate of 22 L/min. ${dec.flowRate > 22 ? 'The extra water ran off or drained past the roots.' : 'The crop may have been short of water during hot spells.'}`)
  if (sc.nutrients < 85) recs.push(`Nitrogen at ${dec.nitrogen} kg/ha is ${Math.abs(dec.nitrogen - 120)} kg/ha ${dec.nitrogen > 120 ? 'above' : 'below'} the model's optimum of 120 kg/ha. ${dec.nitrogen > 120 ? 'Extra fertiliser costs money and adds little yield.' : 'Too little nitrogen caps leaf growth and grain fill.'}`)
  if (!run.complete) recs.push(`You stopped at day ${run.dayReached} of ${run.duration}. Later stages (tasseling and maturity) decide most of the yield, so run to the end to see the full effect of your decisions.`)
  if (!d?.components.length) recs.push('You placed no extra components. Try adding a soil probe and a drip line in the Simulation Workspace and compare your scores.')
  if (!recs.length) recs.push('Strong run. To stretch yourself, try a harder scenario, a different soil type, or the same scenario with a lower water budget.')

  return (
    <div className="page results-page">
      <div className="page-title">
        <div><span>5 · RESULTS & LEARNING</span><strong>{run.scenarioName}</strong>
          <p>{run.farmName} · {run.category} · {run.difficulty} · {run.complete ? 'Completed' : `Stopped at day ${run.dayReached} of ${run.duration}`} · {new Date(run.finishedAt).toLocaleString()}</p></div>
        <div className="title-actions"><Button onClick={shareResults}><Icon name="arrow" size={15} /> Share</Button><Button onClick={onSimulate}><Icon name="reset" size={15} /> Run again</Button><Button className="primary-action" onClick={onBrowse}>Try another scenario <Icon name="arrow" size={15} /></Button></div>
      </div>

      <section className="summary-card">
        <span>SUMMARY</span>
        <p>This run scored <strong>{sc.overall}/100 ({grade(sc.overall)})</strong>. Your strongest area was <strong>{best[0]}</strong> ({best[1]}) and your weakest was <strong>{worst[0]}</strong> ({worst[1]}). {run.complete ? 'The crop reached maturity' : `The simulation was stopped on day ${run.dayReached}, with the crop at ${run.metrics.growth}% of full growth`}, with an estimated yield of <strong>{run.metrics.yieldTHa} t/ha</strong> using {run.metrics.waterUsed} m³ of water. {achieved} of {run.objectives.length} learning objective{run.objectives.length === 1 ? ' was' : 's were'} met.</p>
      </section>

{run.engineResults && (
        <section className="summary-card" style={{ borderColor: 'rgba(85,216,139,.5)', background: 'linear-gradient(135deg, rgba(85,216,139,.12), var(--panel))' }}>
          <span>A14 ENGINE · REAL FAO-56 OUTPUT</span>
          <div className="kpi-row" style={{ marginTop: 12, marginBottom: 8 }}>
            <div className="kpi"><span>YIELD</span><strong>{run.engineResults.yieldTha.toFixed(2)}<small>t/ha</small></strong><em>baseline {run.engineBaseline?.yieldTha.toFixed(2)}</em></div>
            <div className="kpi"><span>WATER USE</span><strong>{run.engineResults.waterUseM3Ha.toFixed(0)}<small>m³/ha</small></strong><em>baseline {run.engineBaseline?.waterUseM3Ha.toFixed(0)}</em></div>
            <div className="kpi"><span>COST</span><strong>R{run.engineResults.costPerHa.toFixed(0)}<small>/ha</small></strong><em>baseline R{run.engineBaseline?.costPerHa.toFixed(0)}</em></div>
            <div className="kpi"><span>GROSS MARGIN</span><strong>R{run.engineResults.grossMarginPerHa.toFixed(0)}<small>/ha</small></strong><em>baseline R{run.engineBaseline?.grossMarginPerHa.toFixed(0)}</em></div>
          </div>
          <p className="muted-note">{run.engineResults.disclaimer}</p>
          <p className="muted-note">Deterministic Spring Boot FAO-56 engine result for the same decisions. The simulator scores above are the teaching layer; the engine here is the actual A14 output.</p>
        </section>
      )}

      <div className="kpi-row">{kpis.map(k => <div className="kpi" key={k.label}><span>{k.label}</span><strong>{k.value}<small>{k.unit}</small></strong><em>{k.sub}</em></div>)}</div>

      <div className="results-grid">
        <section className="panel-card wide">
          <div className="panel-card-title"><span>WHAT HAPPENED</span><strong>The season over time</strong></div>
          <div className="trend-grid">
            <Trend run={run} pick={p => p.moisture} color="#55d88b" label="Soil moisture (%)" target={dec.targetMoisture} />
            <Trend run={run} pick={p => p.growth} color="#4ca6da" label="Crop growth (%)" />
            <Trend run={run} pick={p => p.water} color="#dcad51" label="Cumulative water (m³)" />
          </div>
          <p className="muted-note">The dashed line on the moisture chart is your target. The closer the green line stays to it, the better your moisture-control score. Growth rises as long as the crop has water and nutrients; the water line shows total irrigation to date.</p>
          {stages.length > 0 && (
            <div className="table-wrap"><table className="stage-table">
              <thead><tr><th>Growth stage</th><th>Days</th><th>Avg moisture</th><th>Growth gained</th><th>Water used</th><th>Why it matters</th></tr></thead>
              <tbody>{stages.map(r => <tr key={r.name}><td><strong>{r.name}</strong></td><td>{r.from}–{r.to}</td><td className={Math.abs(r.avgMoisture - dec.targetMoisture) > 12 ? 'warn' : ''}>{r.avgMoisture}% <small>({r.avgMoisture >= dec.targetMoisture ? '+' : ''}{r.avgMoisture - dec.targetMoisture} vs target)</small></td><td>+{r.growthGain}%</td><td>{r.water} m³</td><td>{r.note}</td></tr>)}</tbody>
            </table></div>
          )}
        </section>

        <section className="panel-card">
          <div className="panel-card-title"><span>SCORING IN DETAIL</span><strong>Why you got {sc.overall}/100</strong></div>
          <Explain label="Moisture control" value={sc.moisture} formula="100 − 2.2 × average gap from target + monitoring bonus"
            inputs={gap !== undefined ? `Average gap ${gap} points from the ${dec.targetMoisture}% target → ${Math.round(gap * 2.2)} points lost; monitoring bonus +${d?.bonuses.monitoring ?? 0}.` : `Target moisture was ${dec.targetMoisture}%.`}
            meaning="Steady soil moisture keeps roots supplied and stops stress swings. A low score means the soil was often much drier or wetter than your target."
            improve="Adjust the flow rate to hold moisture near target, add drip lines or pivots to raise moisture, and add soil probes for the monitoring bonus (+2 each, up to +8)." />
          <Explain label="Water efficiency" value={sc.water} formula="100 − 3.5 × |flow rate − 22 L/min| + pump bonus"
            inputs={`Flow rate ${dec.flowRate} L/min is ${Math.abs(dec.flowRate - 22)} L/min from the 22 L/min sweet spot → ${Math.round(Math.abs(dec.flowRate - 22) * 3.5)} points lost; pump bonus +${d?.bonuses.pump ?? 0}.`}
            meaning="Efficient irrigation delivers what the crop uses. Too high wastes water through runoff and drainage; too low leaves the crop short."
            improve="Move the flow rate toward 22 L/min, and add a water pump (+3 each, up to +6) to cut pumping losses." />
          <Explain label="Nutrient management" value={sc.nutrients} formula="100 − 0.9 × |nitrogen − 120 kg/ha|"
            inputs={`Nitrogen ${dec.nitrogen} kg/ha is ${Math.abs(dec.nitrogen - 120)} kg/ha from the 120 kg/ha optimum → ${Math.round(Math.abs(dec.nitrogen - 120) * 0.9)} points lost.`}
            meaning="Nitrogen drives leaf and grain growth, but beyond the optimum extra fertiliser gives diminishing returns and costs more."
            improve="Keep nitrogen close to 120 kg/ha, then test a few kg/ha either side to see the effect on yield." />
          <div className="calc-box">
            <strong>Overall and yield</strong>
            <p>Overall = average of the three scores = ({sc.moisture} + {sc.water} + {sc.nutrients}) ÷ 3 = <b>{sc.overall}</b>.</p>
            <p>Yield = 3.5 + growth ({run.metrics.growth}%) × 8.5 t/ha × quality factor {d?.yieldFactor ?? '—'} = <b>{run.metrics.yieldTHa} t/ha</b>. The quality factor weights moisture 50%, nutrients 30% and water efficiency 20%.</p>
          </div>
          <p className="muted-note">Scores come from the simulator's simplified model. Use them to compare your own runs, not as real-world predictions.</p>
        </section>

        <section className="panel-card">
          <div className="panel-card-title"><span>LEARNING</span><strong>Objectives · {achieved} of {run.objectives.length} met</strong></div>
          <ul className="objective-results">{run.objectives.map((o, i) => (
            <li key={i} className={o.achieved ? 'ok' : ''}><i>{o.achieved ? '✓' : '○'}</i><span>{o.text}<small>{o.achieved ? `Met: you ran at least 60% of the season and scored ${sc.overall}, above the ${55 + i * 6} needed for this objective.` : !run.complete && run.metrics.growth < 60 ? `Not met yet: the objective needs at least 60% of the season, and you reached ${run.metrics.growth}%.` : `Not met: it needs an overall score of ${55 + i * 6}, and you scored ${sc.overall}. Focus on ${worst[0]}.`}</small></span></li>
          ))}</ul>

          <div className="panel-card-title spaced"><span>YOUR DECISIONS</span><strong>Settings you used, and how they compare</strong></div>
          <table className="stage-table compact">
            <thead><tr><th>Setting</th><th>Your value</th><th>Best in model</th><th>Effect</th></tr></thead>
            <tbody>
              <tr><td>Target moisture</td><td>{dec.targetMoisture}%</td><td>55–70%</td><td>{dec.targetMoisture < 55 ? 'Set low: the crop is under mild drought stress.' : dec.targetMoisture > 70 ? 'Set high: risk of waterlogging and wasted water.' : 'In the healthy range.'}</td></tr>
              <tr><td>Flow rate</td><td>{dec.flowRate} L/min</td><td>22 L/min</td><td>{dec.flowRate === 22 ? 'Exactly efficient.' : dec.flowRate > 22 ? 'Over-watering and extra water cost.' : 'Water saved, with some stress risk.'}</td></tr>
              <tr><td>Nitrogen</td><td>{dec.nitrogen} kg/ha</td><td>120 kg/ha</td><td>{dec.nitrogen === 120 ? 'Exactly optimal.' : dec.nitrogen > 120 ? 'Diminishing returns and higher cost.' : 'Limits leaf and grain growth.'}</td></tr>
            </tbody>
          </table>
        </section>

        <section className="panel-card">
          <div className="panel-card-title"><span>CONDITIONS</span><strong>What you started with</strong></div>
          {d ? (
            <div className="decision-grid four">
              <div><span>Soil moisture</span><strong>{d.start.soilMoisture}%</strong></div>
              <div><span>Temperature</span><strong>{d.start.temperature}°C</strong></div>
              <div><span>Humidity</span><strong>{d.start.humidity}%</strong></div>
              <div><span>Rainfall</span><strong>{d.start.rainfall} mm</strong></div>
              <div><span>Budget</span><strong>{d.start.budget.toLocaleString()}</strong></div>
              <div><span>Pest pressure</span><strong>{d.start.pestPressure}%</strong></div>
              <div><span>Weather</span><strong className="cap">{d.start.weather}</strong></div>
              <div><span>Water sources</span><strong className="cap">{d.waterSources.length ? d.waterSources.join(', ') : 'none'}</strong></div>
            </div>
          ) : <p className="muted-note">Detailed starting conditions were not recorded for this older run.</p>}
          {d && d.fields.length > 0 && (
            <table className="stage-table compact"><thead><tr><th>Field</th><th>Crop</th><th>Soil</th><th>Irrigation</th><th>Size</th></tr></thead>
              <tbody>{d.fields.map(f => <tr key={f.name}><td>{f.name}</td><td>{f.crop}</td><td>{f.soil}</td><td>{f.irrigation}</td><td>{f.size} ha</td></tr>)}</tbody></table>
          )}
          {d && d.adjustable.length > 0 && <p className="muted-note">Variables this scenario lets you adjust: {d.adjustable.join(', ')}.</p>}
        </section>

        <section className="panel-card">
          <div className="panel-card-title"><span>COMPONENTS</span><strong>Impact of what you placed</strong></div>
          {d && d.components.length > 0 ? (
            <>
              <ul className="tip-list">{d.components.map((c, i) => <li key={i}>{c.name} <small>({c.kind})</small></li>)}</ul>
              <div className="calc-box">
                <p>Moisture boost from irrigation: <b>+{d.bonuses.moisture}%</b> · extra flow: <b>+{d.bonuses.flow} L/min</b></p>
                <p>Monitoring bonus: <b>+{d.bonuses.monitoring}</b> · pump bonus: <b>+{d.bonuses.pump}</b> · extra storage: <b>+{d.bonuses.storage} m³</b></p>
                <p>Extra land plots: <b>{d.bonuses.landPlots}</b> (each adds about 6% to water demand)</p>
              </div>
            </>
          ) : <p className="muted-note">No extra components were placed in this run. Components from the Simulation Workspace library change moisture, flow and your scores, so try a run with a few to see the difference.</p>}
        </section>

        <section className="panel-card">
          <div className="panel-card-title"><span>EVENTS</span><strong>Key moments in the run</strong></div>
          {d && d.events.length ? <ul className="event-timeline">{d.events.map((e, i) => <li key={i}><i className={e.tone} /><span>{e.time}</span><p>{e.text}</p></li>)}</ul> : <p className="muted-note">No events were recorded.</p>}
        </section>

        <section className="panel-card">
          <div className="panel-card-title"><span>NEXT STEPS</span><strong>What to try next</strong></div>
          <ul className="tip-list">{recs.map(t => <li key={t}>{t}</li>)}</ul>
        </section>

        <section className="panel-card wide">
          <div className="panel-card-title"><span>GLOSSARY</span><strong>Terms used on this page</strong></div>
          <dl className="glossary">
            <dt>Soil moisture</dt><dd>Share of the soil's water-holding capacity currently filled.</dd>
            <dt>Flow rate</dt><dd>Litres per minute delivered by the irrigation system.</dd>
            <dt>Effective flow</dt><dd>Your flow rate plus extra flow from placed drip lines and pivots.</dd>
            <dt>Growth stage</dt><dd>The crop's phase: seedbed, emergence, vegetative, tasseling, maturity.</dd>
            <dt>Stress index</dt><dd>How far the crop is from ideal conditions; lower is better.</dd>
            <dt>Diminishing returns</dt><dd>Beyond a point, more input (water or fertiliser) adds little extra yield.</dd>
          </dl>
        </section>

        <section className="panel-card wide">
          <div className="panel-card-title"><span>RUN HISTORY</span><strong>{history.length} saved run{history.length === 1 ? '' : 's'}</strong></div>
          <div className="history-list">
            {history.map(h => (
              <Button key={h.id} className={`history-row ${h.id === run.id ? 'active' : ''}`} onClick={() => onSelect(h)}>
                <span><strong>{h.scenarioName}</strong><small>{new Date(h.finishedAt).toLocaleString()} · {h.farmName}</small></span>
                <em>{h.complete ? 'Complete' : `Day ${h.dayReached}`}</em><b>{h.scores.overall}</b>
              </Button>
            ))}
          </div>
        </section>
      </div>
    </div>
  )
}
