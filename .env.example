# Copy to .env (which is gitignored) and fill in.
# The `docker compose` command reads .env automatically.

# PostgreSQL
POSTGRES_DB=digitalfarm_DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-prod

# Backend JWT signing secret (must be >= 32 bytes for HS256)
JWT_SECRET=dev-only-do-not-deploy-please-change-this-secret-2026

# Dev JWT injected by nginx into proxied /api requests.
# Generate with the same secret as JWT_SECRET above and a UUID sub.
# See .env.local in the frontend folder for a working example.
SPRING_DEV_TOKEN=

# Ports on the host
POSTGRES_PORT=5432
BACKEND_PORT=8081
FRONTEND_PORT=80